# Brightloop Environment Variables Configuration

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Found in your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase publishable key (or legacy anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service Role Key (SERVER ONLY - NEVER EXPOSE TO CLIENT/BROWSER)
# Used exclusively for server-side background tasks and database admin scripts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Optional — quotation email (Member 2)
RESEND_API_KEY=
QUOTATION_EMAIL_FROM=Brightloop <quotes@yourdomain.com>
